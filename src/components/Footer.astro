<style>
	footer {
		max-width: var(--measure);
		margin: 0 auto;
		padding: 2em 1em 4em;
		border-top: 1px solid var(--line);
		color: var(--ink-muted);
		font-size: 0.85em;
	}
	nav {
		display: flex;
		gap: 1.25em;
		flex-wrap: wrap;
		margin-bottom: 0.75em;
	}
	footer a {
		color: var(--ink-muted);
	}
	footer a:hover {
		color: var(--accent);
	}
	p {
		margin: 0;
	}
