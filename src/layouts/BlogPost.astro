---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';

type Props = CollectionEntry<'blog'>['data'];

const { title, description, pubDate, updatedDate, heroImage, type, topics, status } = Astro.props;
const isSurge = type === 'surge';

const statusLabels: Record<string, string> = {
	forming: 'still forming',
	confident: 'held with confidence',
	revised: 'revised since first publication',
};
---

<html lang="en">
	<head>
		<BaseHead title={title} description={description} image={heroImage} />
	</head>

	<body>
		<Header />
		<main>
			<article class:list={[{ surge: isSurge }]}>
				{isSurge && <p class="surgeMark">a surge: written hot, on purpose</p>}
				<h1>{title}</h1>
				<p class="dateline">
					<FormattedDate date={pubDate} />
					{
						updatedDate && (
							<span>
								{' '}
								· last updated <FormattedDate date={updatedDate} />
							</span>
						)
					}
					{status && <span> · {statusLabels[status]}</span>}
				</p>
				{heroImage && <Image width={1020} height={510} src={heroImage} alt="" />}
				<div class="prose">
					<slot />
				</div>
				<footer class="postFooter">
					{
						topics && topics.length > 0 && (
							<p class="postTopics">
								Filed under{' '}
								{topics.map((t, i) => (
									<span>
										{i > 0 && ', '}
										<a href={`/topics/${t}`}>{t}</a>
									</span>
								))}
							</p>
						)
					}
					<p>
						Disagree, or see something I'm missing? The best part of this site happens over
						email, so <a href={`mailto:harry@harrymunroe.com?subject=Re: ${title}`}>write me back</a>.
					</p>
				</footer>
			</article>
		</main>
		<Footer />

		<style>
			article.surge {
				border-top: 3px solid var(--surge);
				padding-top: 1em;
			}
			.surgeMark {
				color: var(--surge);
				font-style: italic;
				font-size: 0.85em;
				margin: 0 0 0.5em;
			}
			h1 {
				margin-bottom: 0.2em;
			}
			.dateline {
				margin-bottom: 2em;
			}
			.postFooter {
				margin-top: 3em;
				padding-top: 1.25em;
				border-top: 1px solid var(--line);
				color: var(--ink-muted);
				font-size: 0.9em;
			}
			.postTopics {
				font-style: italic;
			}
		</style>
	</body>
</html>
