---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import { topics } from '../data/topics';
---

<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>

	<body>
		<Header />
		<main>
			<section class="hero">
				<h1>Hi, I'm Harry Munroe.</h1>
				<p class="lead">I work on turning technology into capability.</p>
				<p class="subhead">
					Inventing a technology is the first step. It also has to be built at scale, put to use,
					and paid for. I study how the United States and its allies do that, with a focus on the
					Nordic countries. I work at IBM, and this year I'm a fellow at the National Defense
					University's Eisenhower School.
				</p>
				<p class="subhead">
					If you work on any of this, I'd like to hear from you:
					<a href="mailto:harry@harrymunroe.com">harry@harrymunroe.com</a>.
				</p>
			</section>

			<section class="doors">
				<h2>What I work on</h2>
				<div class="topicList">
					{
						topics.map((t) => (
							<a class="topic" href={`/topics/${t.slug}`}>
								<span class="topicLabel">{t.label}</span>
								<span class="topicDesc">{t.desc}</span>
							</a>
						))
					}
				</div>
			</section>

			<section class="doors">
				<h2>Start here</h2>
				<div class="topicList">
					<a class="topic" href="/research">
						<span class="topicLabel">Research</span>
						<span class="topicDesc">Papers, talks, and work in progress.</span>
					</a>
					<a class="topic" href="/work">
						<span class="topicLabel">Work</span>
						<span class="topicDesc">Tools I'm building on public data.</span>
					</a>
					<a class="topic" href="/about">
						<span class="topicLabel">About</span>
						<span class="topicDesc">Who I am and how to reach me.</span>
					</a>
				</div>
			</section>

			<section class="stance">
				<h2>What I hold to</h2>
				<p>
					I believe new technology could make this a much better world, and I'm using this site
					to be specific about how. When I write about dangers, and I will, every
					piece ends with a credible path forward.
				</p>
				<p>
					I explain things at the level you're actually asking, define jargon when it earns its
					place, and leave my thinking visibly unfinished where it is unfinished. You'll disagree
					with some of it. Good. <a href="mailto:harry@harrymunroe.com">Email me</a> and say so.
				</p>
			</section>
		</main>
		<Footer />

		<style>
			.hero {
				padding: 2em 0 1em;
			}
			.hero h1 {
				font-size: clamp(2.2em, 6vw, 3.2em);
				margin-bottom: 0.4em;
			}
			.lead {
				max-width: 40ch;
				font-size: 1.35em;
				line-height: 1.4;
				margin: 0 0 1em;
			}
			.subhead {
				max-width: 60ch;
				font-size: 1.05em;
				color: var(--ink-muted);
			}
			.doors,
			.stance {
				margin-top: 2.5em;
				padding-top: 1.5em;
				border-top: 1px solid var(--line);
			}
			.topicList {
				display: flex;
				flex-direction: column;
			}
			.topic {
				display: flex;
				gap: 1em;
				align-items: baseline;
				padding: 0.7em 0;
				border-bottom: 1px solid var(--line);
				color: var(--ink);
			}
			.topic:last-child {
				border-bottom: none;
			}
			.topic:hover {
				text-decoration: none;
			}
			.topic:hover .topicLabel {
				color: var(--accent-deep);
				text-decoration: underline;
				text-underline-offset: 3px;
			}
			.topicLabel {
				font-weight: 700;
				color: var(--accent);
				min-width: 6.5em;
			}
			.topicDesc {
				color: var(--ink-muted);
				font-size: 0.95em;
			}
			.stance p {
				max-width: 62ch;
			}
			@media (max-width: 600px) {
				.topic {
					flex-direction: column;
					gap: 0.15em;
				}
			}
		</style>
	</body>
</html>
