---
import Page from '../../layouts/Page.astro';
import { topics } from '../../data/topics';
---

<Page
	title="Topics"
	description="Notes, essays, projects, and open questions, organized by idea."
>
	<p class="intro">
		Everything here is organized by idea rather than by date. Each topic collects essays,
		half-formed notes, projects, and the questions I haven't answered yet. Most of it is still in
		progress, which is the point.
	</p>

	<div class="topicList">
		{
			topics.map((t) => (
				<a class="topic" href={`/topics/${t.slug}`}>
					<span class="topicLabel">{t.label}</span>
					<span class="topicDesc">{t.desc}</span>
				</a>
			))
		}
	</div>

	<style>
		.intro {
			max-width: 62ch;
			color: var(--ink-muted);
		}
		.topicList {
			margin-top: 1.5em;
			display: flex;
			flex-direction: column;
		}
		.topic {
			display: flex;
			gap: 1em;
			align-items: baseline;
			padding: 0.8em 0;
			border-bottom: 1px solid var(--line);
			color: var(--ink);
		}
		.topic:last-child {
			border-bottom: none;
		}
		.topic:hover {
			text-decoration: none;
		}
		.topic:hover .topicLabel {
			color: var(--accent-deep);
			text-decoration: underline;
			text-underline-offset: 3px;
		}
		.topicLabel {
			font-weight: 700;
			color: var(--accent);
			min-width: 6.5em;
		}
		.topicDesc {
			color: var(--ink-muted);
			font-size: 0.95em;
		}
		@media (max-width: 600px) {
			.topic {
				flex-direction: column;
				gap: 0.15em;
			}
		}
	</style>
</Page>
